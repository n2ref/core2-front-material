{
  "root": true,
  "env": {
    "browser": true,
    "jquery": true,
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-empty": "off",
    "no-cond-assign": "off",
    "no-constant-condition": "off",
    "no-fallthrough": "off",
    "no-redeclare": "off",
    "no-self-assign": "off",
    "no-unreachable": "off",
    "no-useless-escape": "off",
    "no-prototype-builtins": "off",
    "no-func-assign": "off"
  }
}
